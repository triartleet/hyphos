#!/usr/bin/env python3
"""hyphos — rewrite AI drafts in your own voice, with receipts.

Subcommands:
  rewrite --register R [--backend auto|claude|api] FILE
      Model pass guided by your profiles, then the deterministic enforcement
      pass. Prints the result to stdout and the enforcement report to stderr.
  enforce [--register R] FILE
      Enforcement pass only — deterministic de-model-isming, no model call.
  score --register R FILE
      Model-free fidelity score: stylometric proximity to the register's
      fingerprint plus a model-ism count. 100 ≈ statistically yours.
  blind --register R --generated FILE [-n N]
      Blind self-test: shuffles real corpus snippets with lines from FILE;
      you mark which are yours; reports your discrimination rate.

Backends (D-005): "claude" drives the local claude CLI (your existing
subscription); "api" uses ANTHROPIC_API_KEY. "auto" prefers claude.
Profiles are read from profiles/ (local-only; see profiles/README.md).
"""
import argparse
import json
import os
import random
import re
import shutil
import subprocess
import sys
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
PROFILES = REPO / "profiles"
CORPUS = REPO / "corpus"

# ---------------- adaptation rules (D-008: standardized, testable) ----------------
# Every content-adaptation operation is a declared rule: id, kind, pattern,
# and its OWN test cases. The engine applies rules in listed order
# (deterministic), reports per-rule counts, and `hyphos rules --test`
# verifies every rule against its cases. Personal additions may be dropped
# in profiles/rules.json (same schema) — merged after the built-ins.

RULES = [
    {"id": "opener-worth-noting", "kind": "remove",
     "pattern": r"It(?:'|’)s worth noting that\s+",
     "tests": [{"in": "It's worth noting that X works.", "out": "X works."}]},
    {"id": "opener-importantly", "kind": "remove",
     "pattern": r"Importantly,\s+",
     "tests": [{"in": "Importantly, it passed.", "out": "it passed."}]},
    {"id": "opener-notably", "kind": "remove",
     "pattern": r"Notably,\s+",
     "tests": [{"in": "Notably, both fail.", "out": "both fail."}]},
    {"id": "flattery-standalone", "kind": "remove",
     # standalone sentence only — mid-clause occurrences are flagged, not
     # amputated (learned from a dangling "to prioritize it." in testing)
     "pattern": r"You(?:'|’)re absolutely (?:right|correct)[.!]\s*",
     "tests": [{"in": "You're absolutely right. Next point.", "out": "Next point."},
               {"in": "You're absolutely right to ask.",
                "out": "You're absolutely right to ask."}]},
    {"id": "emdash-pair", "kind": "replace",
     "pattern": r"\s+—\s+([^—\n]{1,60})\s+—\s+", "replacement": r" (\1) ",
     "tests": [{"in": "a — the fix — b", "out": "a (the fix) b"}]},
    {"id": "emdash-single", "kind": "replace",
     "pattern": r"\s+—\s+", "replacement": ", ",
     "tests": [{"in": "clear — mostly", "out": "clear, mostly"}]},
    {"id": "emdash-tight", "kind": "replace",
     # letters only: \w includes digits, and the first self-test run caught
     # this rule mangling year ranges ("1990—1995") exactly as its own
     # docstring promised it wouldn't
     "pattern": r"(?<=[a-zA-Z])—(?=[a-zA-Z])", "replacement": ", ",
     "tests": [{"in": "yes—no", "out": "yes, no"},
               {"in": "1990—1995", "out": "1990—1995"}]},
    {"id": "contrast-flip", "kind": "flag",
     "pattern": r"\b(?:that|this|it)(?:'|’)s not (?:just )?\w[\w\s]{0,30}[—,-]\s*(?:it|that)(?:'|’)s\b",
     "tests": [{"in": "it's not just speed, it's design", "flags": 1}]},
    {"id": "inflation-word", "kind": "flag",
     "pattern": r"\b(?:delve|crucial(?:ly)?|robust|seamless(?:ly)?|comprehensive|pivotal|testament to|tapestry|elevate|game-?changer)\b",
     "tests": [{"in": "a robust and seamless flow", "flags": 2}]},
    {"id": "verdict-phrase", "kind": "flag",
     "pattern": r"\b(?:smoking gun|load-bearing|the single most|the sharpest)\b",
     "tests": [{"in": "that is the smoking gun", "flags": 1}]},
    {"id": "flattery-clause", "kind": "flag",
     "pattern": r"\byou(?:'|’)re absolutely (?:right|correct)\b",
     "tests": [{"in": "you're absolutely right to ask", "flags": 1}]},
    {"id": "bold-sprinkle", "kind": "flag",
     "pattern": r"\*\*[^*\n]{1,30}\*\*",
     "tests": [{"in": "the **key** point", "flags": 1}]},
]

PIPELINE_FIXTURES = [
    {"in": "Importantly, this — mostly — works.",
     "out": "this (mostly) works."},
]


def load_rules() -> list:
    rules = list(RULES)
    overlay = PROFILES / "rules.json"
    if overlay.is_file():
        try:
            rules += json.loads(overlay.read_text())
        except Exception:
            pass
    return rules


def apply_one(rule: dict, text: str) -> tuple[str, int]:
    if rule["kind"] == "remove":
        return re.subn(rule["pattern"], "", text)
    if rule["kind"] == "replace":
        return re.subn(rule["pattern"], rule["replacement"], text)
    return text, len(re.findall(rule["pattern"], text, flags=re.I))


def enforce(text: str) -> tuple[str, dict]:
    report = {"applied": {}, "flags": {}}
    for rule in load_rules():
        if rule["kind"] == "flag":
            _, n = apply_one(rule, text)
            if n:
                report["flags"][rule["id"]] = n
        else:
            text, n = apply_one(rule, text)
            if n:
                report["applied"][rule["id"]] = n
    text = re.sub(r"[ \t]{2,}", " ", text)
    return text, report


def rules_selftest(verbose: bool = True) -> int:
    failures = 0
    for rule in load_rules():
        for t in rule.get("tests", []):
            out, n = apply_one(rule, t["in"])
            if "out" in t and out != t["out"]:
                failures += 1
                print(f"FAIL {rule['id']}: {t['in']!r} -> {out!r}, "
                      f"expected {t['out']!r}")
            elif "flags" in t and n != t["flags"]:
                failures += 1
                print(f"FAIL {rule['id']}: {t['in']!r} flagged {n}, "
                      f"expected {t['flags']}")
    for fx in PIPELINE_FIXTURES:
        out, _ = enforce(fx["in"])
        if out != fx["out"]:
            failures += 1
            print(f"FAIL pipeline: {fx['in']!r} -> {out!r}, expected {fx['out']!r}")
    if verbose:
        n_rules = len(load_rules())
        n_tests = sum(len(r.get('tests', [])) for r in load_rules()) + len(PIPELINE_FIXTURES)
        print(f"{n_rules} rules, {n_tests} tests, {failures} failure(s)")
    return failures


# ---------------- scoring (model-free) ----------------

def text_metrics(text: str) -> dict:
    words = re.findall(r"[\w']+", text)
    n = len(words) or 1
    sents = [s for s in re.split(r"[.!?\n]+", text) if s.strip()]
    slens = [len(re.findall(r"[\w']+", s)) for s in sents if s.strip()]
    per1k = lambda c: c * 1000 / n
    return {
        "emdash_per_1k": per1k(text.count("—")),
        "comma_per_1k": per1k(text.count(",")),
        "excl_per_1k": per1k(text.count("!")),
        "contractions_per_1k": per1k(len(re.findall(r"\b\w+'(?:s|t|re|ve|ll|d|m)\b", text, re.I))),
        "sent_p50": sorted(slens)[len(slens) // 2] if slens else 0,
        "lower_start_rate": (sum(1 for s in sents if s.strip()[:1].islower())
                             / (len(sents) or 1)),
    }


def load_fingerprint(register: str) -> dict:
    fp = PROFILES / register / "fingerprint.json"
    if not fp.is_file():
        sys.exit(f"no fingerprint for register '{register}' — run bin/profile_fingerprint.py")
    return json.loads(fp.read_text())


def score(text: str, register: str) -> dict:
    fp = load_fingerprint(register)
    m = text_metrics(text)
    ref = {
        "emdash_per_1k": fp["punct_per_1k_words"].get("—", 0.0),
        "comma_per_1k": fp["punct_per_1k_words"].get(",", 0.0),
        "excl_per_1k": fp["punct_per_1k_words"].get("!", 0.0),
        "contractions_per_1k": fp["contractions_per_1k"],
        "sent_p50": fp["sentence_len"]["p50"],
        "lower_start_rate": fp["lowercase_sentence_start_rate"],
    }
    scales = {"emdash_per_1k": 2.0, "comma_per_1k": 20.0, "excl_per_1k": 2.0,
              "contractions_per_1k": 8.0, "sent_p50": 6.0, "lower_start_rate": 0.3}
    weights = {"emdash_per_1k": 3.0, "comma_per_1k": 1.0, "excl_per_1k": 1.0,
               "contractions_per_1k": 1.5, "sent_p50": 1.0, "lower_start_rate": 1.0}
    # Short texts give noisy rate estimates: dampen the high-variance metrics
    # by length so a 60-word email isn't punished for not matching aggregate
    # statistics it could never exhibit. Robust signals keep full weight.
    n_words = len(re.findall(r"[\w']+", text)) or 1
    damp = min(1.0, n_words / 250)
    noisy = {"comma_per_1k", "excl_per_1k", "sent_p50", "lower_start_rate"}
    penalty = total_w = 0.0
    deltas = {}
    for k, ref_v in ref.items():
        d = min(abs(m[k] - ref_v) / scales[k], 1.0)
        deltas[k] = {"text": round(m[k], 2), "register": round(ref_v, 2)}
        w = weights[k] * (damp if k in noisy else 1.0)
        penalty += d * w
        total_w += w
    _, rep = enforce(text)
    ism_hits = sum(rep["applied"].values()) + sum(rep["flags"].values())
    ism_pen = min(ism_hits * 0.06, 0.4)
    fidelity = max(0.0, (1 - penalty / total_w) * (1 - ism_pen)) * 100
    # Honest uncertainty: rate statistics from short texts are noise, and the
    # stylometric half of this score is only trustworthy at length. Calibration
    # against the owner's blind-test judgment is the pending stage-3 step.
    confidence = "ok" if n_words >= 250 else "low"
    return {"fidelity": round(fidelity, 1), "confidence": confidence,
            "model_ism_signals": ism_hits, "metric_deltas": deltas,
            "note": "uncalibrated v1 — the model-ism count is the robust "
                    "signal on short texts; fidelity needs >=250 words and "
                    "blind-test calibration"}


# ---------------- backends ----------------

def build_prompt(register: str, draft: str) -> str:
    guide = (PROFILES / register / "styleguide.md")
    isms = PROFILES / "model-isms.md"
    parts = ["Rewrite the draft below so it reads as written by the person",
             "described in the style guide. Preserve the meaning and all facts.",
             "Match the register exactly; keep protected quirks; remove every",
             "anti-pattern. Output ONLY the rewritten text.\n"]
    if guide.is_file():
        parts += ["== STYLE GUIDE ==", guide.read_text()]
    if isms.is_file():
        parts += ["== ANTI-PATTERNS (never produce these) ==", isms.read_text()]
    parts += ["== DRAFT ==", draft]
    return "\n".join(parts)


def call_claude_cli(prompt: str) -> str:
    exe = shutil.which("claude")
    if not exe:
        raise RuntimeError("claude CLI not found on PATH")
    r = subprocess.run([exe, "-p", prompt], capture_output=True, text=True,
                       timeout=600)
    if r.returncode != 0:
        raise RuntimeError(f"claude CLI failed: {r.stderr[:300]}")
    return r.stdout.strip()


def call_api(prompt: str) -> str:
    key = os.environ.get("ANTHROPIC_API_KEY")
    if not key:
        raise RuntimeError("ANTHROPIC_API_KEY not set")
    body = json.dumps({
        "model": os.environ.get("HYPHOS_MODEL", "claude-sonnet-5"),
        "max_tokens": 4096,
        "messages": [{"role": "user", "content": prompt}],
    }).encode()
    req = urllib.request.Request(
        "https://api.anthropic.com/v1/messages", data=body,
        headers={"x-api-key": key, "anthropic-version": "2023-06-01",
                 "content-type": "application/json"})
    with urllib.request.urlopen(req, timeout=300) as resp:
        data = json.load(resp)
    return "".join(b.get("text", "") for b in data.get("content", [])).strip()


def rewrite(register: str, draft: str, backend: str) -> tuple[str, dict, str]:
    prompt = build_prompt(register, draft)
    order = (["claude", "api"] if backend == "auto" else [backend])
    last_err = None
    for b in order:
        try:
            out = call_claude_cli(prompt) if b == "claude" else call_api(prompt)
            final, report = enforce(out)
            return final, report, b
        except Exception as e:  # try next backend
            last_err = e
    sys.exit(f"no backend succeeded: {last_err}")


# ---------------- blind test ----------------

def blind(register: str, generated_file: Path, n: int):
    tagged = CORPUS / "tagged.jsonl"
    real = []
    for line in tagged.open():
        o = json.loads(line)
        if o["register"] == register and 25 <= o["words"] <= 120:
            real.append(o["text"])
    gen = [p.strip() for p in
           re.split(r"\n\s*\n", generated_file.read_text()) if
           len(p.split()) >= 15]
    n = min(n, len(real), len(gen))
    items = ([(t, True) for t in random.sample(real, n)]
             + [(t, False) for t in random.sample(gen, n)])
    random.shuffle(items)
    correct = 0
    print(f"{2*n} snippets. Answer y if YOU wrote it, n if not.\n")
    for i, (text, is_real) in enumerate(items, 1):
        print(f"--- {i}/{2*n} ---\n{text[:400]}\n")
        ans = input("yours? [y/n] ").strip().lower()
        if (ans == "y") == is_real:
            correct += 1
    rate = correct / (2 * n)
    print(f"\ndiscrimination: {correct}/{2*n} = {rate:.0%}")
    print("50% = the rewrite is indistinguishable from you; "
          "100% = it fools you never.")


# ---------------- registers as data (D-007) ----------------

def registers_info() -> list:
    """Discover registers from profile buckets. A register exists because
    corpus exists; confidence reflects sampling depth, and low confidence
    advertises its cure (more samples) instead of hiding the register."""
    out = []
    if not PROFILES.is_dir():
        return out
    for d in sorted(PROFILES.iterdir()):
        fp = d / "fingerprint.json"
        if not d.is_dir() or not fp.is_file() or d.name.endswith("-pre2023"):
            continue
        words = json.loads(fp.read_text()).get("words", 0)
        conf = "high" if words >= 30000 else "medium" if words >= 8000 else "low"
        out.append({"register": d.name, "words": words, "confidence": conf,
                    "hint": None if conf != "low" else
                    "low sampling — add source material to sharpen this voice"})
    return out


def infer_register(text: str) -> dict:
    """Pick the closest register for a draft by stylometric proximity.
    Confidence comes from the margin between the top two candidates."""
    ranked = []
    for r in registers_info():
        # Low-sample buckets have unstable fingerprints and can win proximity
        # by accident — inference only ranks registers the tool can actually
        # produce confidently (they stay selectable by hand).
        if r["confidence"] == "low":
            continue
        try:
            ranked.append((score(text, r["register"])["fidelity"], r["register"]))
        except SystemExit:
            continue
    if not ranked:
        return {"register": "editorial", "confidence": "none", "scores": {}}
    ranked.sort(reverse=True)
    margin = ranked[0][0] - (ranked[1][0] if len(ranked) > 1 else 0)
    return {"register": ranked[0][1],
            "confidence": "high" if margin >= 15 else "low",
            "scores": {r: round(s, 1) for s, r in ranked}}


def record_feedback(entry: dict) -> dict:
    """Append a good/fine/bad verdict (with optional justification) and
    return aggregate counts plus a suggestion when evidence accumulates."""
    import datetime
    fb = CORPUS / "feedback.jsonl"
    entry = {"ts": datetime.datetime.now().isoformat(timespec="seconds"),
             "register": entry.get("register", "?"),
             "verdict": entry.get("verdict", "fine"),
             "note": (entry.get("note") or "")[:500]}
    with fb.open("a") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    counts = {"good": 0, "fine": 0, "bad": 0}
    for line in fb.open():
        o = json.loads(line)
        if o.get("register") == entry["register"] and o.get("verdict") in counts:
            counts[o["verdict"]] += 1
    suggestion = None
    if counts["bad"] >= 3 and counts["bad"] > counts["good"]:
        suggestion = ("this register keeps disappointing — expand its source "
                      "material (drop samples in corpus/) or revisit its style "
                      "guide; the justifications in corpus/feedback.jsonl say why")
    return {"counts": counts, "suggestion": suggestion}


# ---------------- local web app ----------------

def serve(port: int):
    """Serve the Translate-style web UI on localhost only (D-001: the data
    plane never leaves the machine; the server binds 127.0.0.1)."""
    import http.server

    web = REPO / "web"
    types = {".html": "text/html", ".json": "application/json",
             ".js": "text/javascript", ".svg": "image/svg+xml",
             ".css": "text/css", ".webmanifest": "application/manifest+json"}

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _json(self, code, obj):
            body = json.dumps(obj, ensure_ascii=False).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            name = self.path.split("?")[0].lstrip("/") or "index.html"
            f = (web / name).resolve()
            if not f.is_file() or web.resolve() not in f.parents:
                self.send_response(404); self.end_headers(); return
            body = f.read_bytes()
            self.send_response(200)
            self.send_header("Content-Type",
                             types.get(f.suffix, "application/octet-stream"))
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self):
            try:
                n = int(self.headers.get("Content-Length", 0))
                body = json.loads(self.rfile.read(n) or b"{}")
                text = body.get("text", "")
                register = body.get("register", "editorial")
                if self.path == "/api/registers":
                    self._json(200, {"registers": registers_info()})
                elif self.path == "/api/infer":
                    self._json(200, infer_register(text))
                elif self.path == "/api/feedback":
                    self._json(200, record_feedback(body))
                elif self.path == "/api/rewrite":
                    inferred = None
                    if register == "auto":
                        inferred = infer_register(text)
                        register = inferred["register"]
                    out, rep, backend = rewrite(register, text,
                                                body.get("backend", "auto"))
                    self._json(200, {"text": out, "enforcement": rep,
                                     "backend": backend, "register": register,
                                     "inferred": inferred,
                                     "score": score(out, register)})
                elif self.path == "/api/enforce":
                    out, rep = enforce(text)
                    self._json(200, {"text": out, "enforcement": rep})
                elif self.path == "/api/score":
                    self._json(200, score(text, register))
                else:
                    self._json(404, {"error": "unknown endpoint"})
            except SystemExit as e:
                self._json(502, {"error": str(e)})
            except Exception as e:
                self._json(500, {"error": str(e)})

    httpd = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    print(f"hyphos serving on http://127.0.0.1:{port} (local only, Ctrl-C stops)")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


# ---------------- main ----------------

def main():
    ap = argparse.ArgumentParser(prog="hyphos")
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("rewrite", "enforce", "score"):
        p = sub.add_parser(name)
        p.add_argument("file", type=Path)
        p.add_argument("--register", default="editorial")
        if name == "rewrite":
            p.add_argument("--backend", default="auto",
                           choices=["auto", "claude", "api"])
    b = sub.add_parser("blind")
    b.add_argument("--register", default="technical-instruction")
    b.add_argument("--generated", type=Path, required=True)
    b.add_argument("-n", type=int, default=5)
    s = sub.add_parser("serve")
    s.add_argument("--port", type=int, default=4177)
    r = sub.add_parser("rules")
    r.add_argument("--test", action="store_true")
    a = ap.parse_args()

    if a.cmd == "rules":
        if a.test:
            sys.exit(1 if rules_selftest() else 0)
        for rule in load_rules():
            print(f"{rule['id']:<22} {rule['kind']:<8} "
                  f"{len(rule.get('tests', []))} test(s)")
        return
    if a.cmd == "serve":
        return serve(a.port)
    if a.cmd == "blind":
        return blind(a.register, a.generated, a.n)
    text = a.file.read_text()
    if a.cmd == "enforce":
        out, report = enforce(text)
        sys.stdout.write(out)
        print("\n== enforcement ==\n" + json.dumps(report, indent=1),
              file=sys.stderr)
    elif a.cmd == "score":
        print(json.dumps(score(text, a.register), indent=1))
    elif a.cmd == "rewrite":
        out, report, backend = rewrite(a.register, text, a.backend)
        sys.stdout.write(out)
        print(f"\n== backend: {backend} ==\n== enforcement ==\n"
              + json.dumps(report, indent=1), file=sys.stderr)


if __name__ == "__main__":
    main()
